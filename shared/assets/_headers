/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; worker-src 'self'; manifest-src 'self'; connect-src 'self'; media-src blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), screen-wake-lock=(self), publickey-credentials-create=(self), publickey-credentials-get=(self), clipboard-write=(self), clipboard-read=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Cache-Control: no-cache, max-age=0, must-revalidate

/sw.js
  Content-Type: application/javascript; charset=utf-8
  Service-Worker-Allowed: /
  Netlify-CDN-Cache-Control: no-store

/release.json
  Content-Type: application/json; charset=utf-8
  Netlify-CDN-Cache-Control: no-store

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
