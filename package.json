{
  "name": "latch-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config apps/pwa/vite.config.js --host 127.0.0.1",
    "build": "npm run build:pwa && npm run build:native",
    "build:pwa": "vite build --config apps/pwa/vite.config.js && node build-tools/finalize-release.js && node build-tools/check-release.js && node build-tools/check-hosting.js",
    "build:native": "vite build --config build-tools/vite.native.config.js",
    "preview": "vite preview --config apps/pwa/vite.config.js --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "native:sync": "npm run build:native && cap sync",
    "ios:sync": "npm run build:native && cap sync ios",
    "android:sync": "npm run build:native && cap sync android",
    "ios:open": "cap open ios",
    "android:open": "cap open android",
    "check:deployment": "node build-tools/check-deployment.js"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@noble/hashes": "2.0.1",
    "@theqrl/wallet.js": "6.3.0",
    "@theqrl/web3-qrl-accounts": "1.0.3",
    "aes-js": "3.1.2",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "html5-qrcode": "2.3.8",
    "lucide-vue-next": "0.468.0",
    "qrcode": "1.5.4",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@vitejs/plugin-vue": "6.0.8",
    "daisyui": "5.7.9",
    "fake-indexeddb": "6.2.6",
    "postcss": "8.5.25",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0"
  },
  "workspaces": [
    "apps/pwa",
    "shared"
  ]
}
